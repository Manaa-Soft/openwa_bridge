[
    {
        "name":  "WhatsApp Account-openwa_gateway_section",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_gateway_section",
        "fieldtype":  "Section Break",
        "label":  "OpenWA Gateway",
        "collapsible":  1
    },
    {
        "name":  "WhatsApp Account-openwa_enabled",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_enabled",
        "fieldtype":  "Check",
        "insert_after":  "openwa_gateway_section",
        "label":  "OpenWA Enabled"
    },
    {
        "name":  "WhatsApp Account-openwa_base_url",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_base_url",
        "fieldtype":  "Data",
        "insert_after":  "openwa_enabled",
        "label":  "OpenWA Base URL",
        "default":  "http://localhost:2785",
        "depends_on":  "eval:doc.openwa_enabled"
    },
    {
        "name":  "WhatsApp Account-openwa_session_id",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_session_id",
        "fieldtype":  "Data",
        "insert_after":  "openwa_base_url",
        "label":  "OpenWA Session ID",
        "depends_on":  "eval:doc.openwa_enabled",
        "read_only":  1
    },
    {
        "name":  "WhatsApp Account-openwa_column_break",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_column_break",
        "fieldtype":  "Column Break",
        "insert_after":  "openwa_session_id",
        "depends_on":  "eval:doc.openwa_enabled"
    },
    {
        "name":  "WhatsApp Account-openwa_api_key",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_api_key",
        "fieldtype":  "Password",
        "insert_after":  "openwa_column_break",
        "label":  "OpenWA API Key",
        "depends_on":  "eval:doc.openwa_enabled"
    },
    {
        "name":  "WhatsApp Account-openwa_webhook_secret",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_webhook_secret",
        "fieldtype":  "Password",
        "insert_after":  "openwa_api_key",
        "label":  "OpenWA Webhook Secret",
        "depends_on":  "eval:doc.openwa_enabled"
    },
    {
        "name":  "WhatsApp Account-openwa_webhook_events",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_webhook_events",
        "fieldtype":  "Small Text",
        "insert_after":  "openwa_webhook_secret",
        "label":  "Webhook Events",
        "depends_on":  "eval:doc.openwa_enabled",
        "default":  "[\"message.received\",\"message.sent\",\"message.ack\",\"message.failed\",\"message.revoked\",\"message.reaction\",\"session.status\",\"session.qr\",\"session.authenticated\",\"session.disconnected\"]",
        "description":  "JSON array of events to subscribe to. Click 'Manage Events' button below to select events visually."
    },
    {
        "name":  "WhatsApp Account-openwa_settings_section",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_settings_section",
        "fieldtype":  "Section Break",
        "insert_after":  "openwa_webhook_secret",
        "label":  "Settings",
        "collapsible":  1,
        "depends_on":  "eval:doc.openwa_enabled"
    },
    {
        "name":  "WhatsApp Account-openwa_hmac_strict",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_hmac_strict",
        "fieldtype":  "Check",
        "insert_after":  "openwa_settings_section",
        "label":  "Require HMAC Signature",
        "depends_on":  "eval:doc.openwa_enabled",
        "description":  "When checked, incoming webhooks without a valid HMAC signature are rejected."
    },
    {
        "name":  "WhatsApp Account-openwa_api_timeout",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_api_timeout",
        "fieldtype":  "Int",
        "insert_after":  "openwa_hmac_strict",
        "label":  "API Timeout (seconds)",
        "default":  "30",
        "depends_on":  "eval:doc.openwa_enabled",
        "description":  "HTTP timeout for OpenWA REST API calls. Default: 30s."
    },
    {
        "name":  "WhatsApp Account-openwa_session_start_timeout",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_session_start_timeout",
        "fieldtype":  "Int",
        "insert_after":  "openwa_api_timeout",
        "label":  "Session Start Timeout (seconds)",
        "default":  "60",
        "depends_on":  "eval:doc.openwa_enabled",
        "description":  "HTTP timeout when starting an OpenWA session. Default: 60s."
    },
    {
        "name":  "WhatsApp Account-openwa_settings_col1",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_settings_col1",
        "fieldtype":  "Column Break",
        "insert_after":  "openwa_session_start_timeout",
        "depends_on":  "eval:doc.openwa_enabled"
    },
    {
        "name":  "WhatsApp Account-openwa_rate_limit",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_rate_limit",
        "fieldtype":  "Int",
        "insert_after":  "openwa_settings_col1",
        "label":  "Webhook Rate Limit (req/min)",
        "default":  "60",
        "depends_on":  "eval:doc.openwa_enabled",
        "description":  "Max inbound webhook requests per minute per IP. Default: 60."
    },
    {
        "name":  "WhatsApp Account-openwa_cb_threshold",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_cb_threshold",
        "fieldtype":  "Int",
        "insert_after":  "openwa_rate_limit",
        "label":  "Circuit Breaker Threshold",
        "default":  "5",
        "depends_on":  "eval:doc.openwa_enabled",
        "description":  "Number of consecutive send failures before circuit breaker trips. Default: 5."
    },
    {
        "name":  "WhatsApp Account-openwa_settings_col2",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_settings_col2",
        "fieldtype":  "Column Break",
        "insert_after":  "openwa_cb_threshold",
        "depends_on":  "eval:doc.openwa_enabled"
    },
    {
        "name":  "WhatsApp Account-openwa_cb_cooldown",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_cb_cooldown",
        "fieldtype":  "Int",
        "insert_after":  "openwa_settings_col2",
        "label":  "Circuit Breaker Cooldown (seconds)",
        "default":  "300",
        "depends_on":  "eval:doc.openwa_enabled",
        "description":  "Seconds to wait before retrying after circuit breaker trips. Default: 300."
    },
    {
        "name":  "WhatsApp Account-openwa_max_outbox_attempts",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_max_outbox_attempts",
        "fieldtype":  "Int",
        "insert_after":  "openwa_cb_cooldown",
        "label":  "Max Outbox Retry Attempts",
        "default":  "5",
        "depends_on":  "eval:doc.openwa_enabled",
        "description":  "Max delivery retries per outbox entry before marking as Failed. Default: 5."
    },
    {
        "name":  "WhatsApp Account-openwa_qr_html",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_qr_html",
        "fieldtype":  "HTML",
        "insert_after":  "openwa_max_outbox_attempts",
        "label":  "QR Code"
    },
    {
        "name":  "WhatsApp Account-openwa_meta_separator",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Account",
        "fieldname":  "openwa_meta_separator",
        "fieldtype":  "Section Break",
        "insert_after":  "openwa_qr_html",
        "label":  "Meta Cloud API"
    },
    {
        "name":  "WhatsApp Templates-openwa_sync_section",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Templates",
        "fieldname":  "openwa_sync_section",
        "fieldtype":  "Section Break",
        "label":  "OpenWA Sync",
        "collapsible":  1
    },
    {
        "name":  "WhatsApp Templates-openwa_synced",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Templates",
        "fieldname":  "openwa_synced",
        "fieldtype":  "Check",
        "insert_after":  "openwa_sync_section",
        "label":  "Synced to OpenWA",
        "read_only":  1
    },
    {
        "name":  "WhatsApp Templates-openwa_template_id",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Templates",
        "fieldname":  "openwa_template_id",
        "fieldtype":  "Data",
        "insert_after":  "openwa_synced",
        "label":  "OpenWA Template ID",
        "read_only":  1
    },
    {
        "name":  "WhatsApp Templates-openwa_dynamic_header",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Templates",
        "fieldname":  "openwa_dynamic_header",
        "fieldtype":  "Check",
        "insert_after":  "header_type",
        "label":  "Dynamic Image Header"
    },
    {
        "name":  "WhatsApp Templates-openwa_print_format",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Templates",
        "fieldname":  "openwa_print_format",
        "fieldtype":  "Link",
        "options":  "Print Format",
        "insert_after":  "openwa_dynamic_header",
        "label":  "Print Format for Header",
        "depends_on":  "openwa_dynamic_header",
        "mandatory_depends_on":  "openwa_dynamic_header"
    },
    {
        "name":  "WhatsApp Templates-openwa_include_letterhead",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Templates",
        "fieldname":  "openwa_include_letterhead",
        "fieldtype":  "Check",
        "insert_after":  "openwa_print_format",
        "label":  "Include Letter Head",
        "depends_on":  "openwa_dynamic_header",
        "default":  "1"
    },
    {
        "name":  "WhatsApp Templates-openwa_letterhead",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Templates",
        "fieldname":  "openwa_letterhead",
        "fieldtype":  "Link",
        "options":  "Letter Head",
        "insert_after":  "openwa_include_letterhead",
        "label":  "Letter Head for Image",
        "depends_on":  "eval:doc.openwa_dynamic_header \u0026\u0026 doc.openwa_include_letterhead"
    },
    {
        "name":  "WhatsApp Notification-openwa_send_type",
        "doctype":  "Custom Field",
        "dt":  "WhatsApp Notification",
        "fieldname":  "openwa_send_type",
        "fieldtype":  "Select",
        "options":  "\nJinja\nTemplate",
        "insert_after":  "doctype_event",
        "label":  "OpenWA Send Type"
    },
