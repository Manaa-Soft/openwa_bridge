[
 {
  "dt": "WhatsApp Account",
  "fieldname": "openwa_section",
  "fieldtype": "Section Break",
  "label": "OpenWA Gateway",
  "insert_after": "allow_auto_read_receipt",
  "collapsible": 1
 },
 {
  "dt": "WhatsApp Account",
  "fieldname": "openwa_enabled",
  "fieldtype": "Check",
  "label": "OpenWA Enabled",
  "default": "0",
  "insert_after": "openwa_section",
  "description": "Route outgoing messages through OpenWA instead of Meta Cloud API."
 },
 {
  "dt": "WhatsApp Account",
  "fieldname": "openwa_column_break_1",
  "fieldtype": "Column Break",
  "insert_after": "openwa_enabled"
 },
 {
  "dt": "WhatsApp Account",
  "fieldname": "openwa_base_url",
  "fieldtype": "Data",
  "label": "OpenWA Base URL",
  "default": "http://localhost:2785",
  "insert_after": "openwa_column_break_1",
  "description": "Root URL of the OpenWA Gateway instance (no trailing slash)."
 },
 {
  "dt": "WhatsApp Account",
  "fieldname": "openwa_session_id",
  "fieldtype": "Data",
  "label": "OpenWA Session ID",
  "insert_after": "openwa_base_url",
  "description": "Session identifier in OpenWA that maps to this WhatsApp Account."
 },
 {
  "dt": "WhatsApp Account",
  "fieldname": "openwa_column_break_2",
  "fieldtype": "Column Break",
  "insert_after": "openwa_session_id"
 },
 {
  "dt": "WhatsApp Account",
  "fieldname": "openwa_api_key",
  "fieldtype": "Password",
  "label": "OpenWA API Key",
  "insert_after": "openwa_column_break_2",
  "description": "API key used to authenticate outbound requests to OpenWA."
 },
 {
  "dt": "WhatsApp Account",
  "fieldname": "openwa_webhook_secret",
  "fieldtype": "Password",
  "label": "OpenWA Webhook Secret",
  "insert_after": "openwa_api_key",
  "description": "Shared secret for HMAC-SHA256 verification of inbound OpenWA webhooks."
 }
]
